<Window x:Class="Aurum.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aurum Meter" Width="450" Height="470" MinWidth="240" MinHeight="280" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" Foreground="#F6F0E5" UseLayoutRounding="True">
 <Border x:Name="Frame" Background="#F2111214" BorderBrush="#776047" BorderThickness="1" CornerRadius="13" Padding="18,14,18,12">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid x:Name="DragArea" Background="Transparent" Cursor="SizeAll" ToolTip="Przeciągnij nagłówek, aby przesunąć licznik"
        PreviewMouseLeftButtonDown="HeaderDown" PreviewMouseMove="HeaderMove" PreviewMouseLeftButtonUp="HeaderUp" LostMouseCapture="HeaderCaptureLost">
   <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image x:Name="MeterBrand" Width="30" Height="30" Margin="0,0,9,0"/>
    <StackPanel><TextBlock Text="A U R U M" Foreground="{StaticResource Gold}" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="BrandSubtitle" Text="C O M B A T   M E T E R" FontSize="8" Foreground="{StaticResource Muted}" /></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="↻" Click="ResetClick" ToolTip="Nowy pomiar" Padding="8,3" Margin="0,0,5,0" /><Button Content="—" Click="HideClick" ToolTip="Ukryj • Ctrl+Shift+M" Padding="8,3" /></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,18,0,13">
   <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel><TextBlock x:Name="FightTitle" Text="Czekam na walkę" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="FightState" Text="" Visibility="Collapsed" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="KillTimeLabel" Visibility="Collapsed" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="Szacowany czas przy tempie ubywania HP bossa z ostatnich około 10 sekund. Zmienia się przy mechanikach, przerwach i zmianie obrażeń." /></StackPanel>
   <TextBlock x:Name="ClockLabel" Grid.Column="1" Text="00:00" FontSize="21" Foreground="{StaticResource Gold}" FontFamily="Consolas" VerticalAlignment="Center" Margin="10,0,0,0" />
  </Grid>
  <Grid Grid.Row="2" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Button x:Name="DpsButton" Content="DPS" Click="DpsClick" Margin="0,0,5,0" /><Button x:Name="HealButton" Content="✚ HEAL" Click="HealClick" /></StackPanel>
   <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock x:Name="TotalLabel" Text="0" FontSize="18" FontWeight="SemiBold" TextAlignment="Right" /><TextBlock x:Name="MetricCaption" Text="OBRAŻENIA" Foreground="{StaticResource Muted}" FontSize="8" TextAlignment="Right" /></StackPanel>
  </Grid>
  <Grid Grid.Row="3">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AurumVerticalScrollBar}" /></ScrollViewer.Resources>
    <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
     <Button Click="PlayerClick" Tag="{Binding ActorId}" Padding="0" Margin="0,0,0,6" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ToolTip="{Binding Tip}"
             ToolTipOpening="PlayerTooltipOpening" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="30000">
      <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate></Button.Template>
      <Border Background="#191A1D" CornerRadius="7" Padding="10,9">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Rank}" Foreground="{StaticResource Gold}" FontSize="11" VerticalAlignment="Center" />
         <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding ClassAndCp}" Foreground="{StaticResource Muted}" FontSize="9" /></Viewbox></StackPanel>
         <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Rate}" FontSize="{DynamicResource RowRateFont}" FontWeight="SemiBold" Foreground="{StaticResource Gold}" TextAlignment="Right" /><TextBlock Text="{Binding Amount}" FontSize="9" Foreground="{StaticResource Muted}" TextAlignment="Right" /></StackPanel>
        </Grid>
        <ProgressBar Grid.Row="1" Value="{Binding Fill, Mode=OneWay}" Maximum="1" Height="3" Margin="22,6,0,0" Background="#292820" Foreground="{StaticResource Gold}" BorderThickness="0" />
       </Grid>
      </Border>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <TextBlock x:Name="EmptyLabel" Text="Dane pojawią się podczas walki." Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="290" TextAlignment="Center" />
  </Grid>
  <Border Grid.Row="4" BorderBrush="#383124" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
   <Button Content="Historia" Click="HistoryClick" HorizontalAlignment="Right" FontSize="10" Padding="7,3" />
  </Border>
 </Grid>
 </Border>
</Window>
