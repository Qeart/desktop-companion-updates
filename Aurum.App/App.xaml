<Application x:Class="Aurum.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Gold" Color="#E6BE6A" />
  <SolidColorBrush x:Key="Muted" Color="#9A9387" />
  <Style x:Key="AurumScrollTrackButton" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AurumVerticalScrollBar" TargetType="ScrollBar">
   <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Black" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
     <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
            Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
            ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource AurumScrollTrackButton}" /></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb MinHeight="24" Margin="2,1">
       <Thumb.Template><ControlTemplate TargetType="Thumb">
        <Border x:Name="ThumbBody" Background="#303030" CornerRadius="3" />
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#484848" /></Trigger>
         <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#606060" /></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Thumb.Template>
      </Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource AurumScrollTrackButton}" /></Track.IncreaseRepeatButton>
     </Track>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E6BE6A" /><Setter Property="Background" Value="#211D15" />
   <Setter Property="BorderBrush" Value="#4B3C23" /><Setter Property="BorderThickness" Value="1" />
   <Setter Property="Padding" Value="12,6" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Focusable" Value="False" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#E6BE6A" /></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
