<Window x:Class="Aurum.PetTrackerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurum • tracker petów" Width="326" Height="468" MinWidth="282" MinHeight="280" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#F4EDDE" FontFamily="Segoe UI" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="TrackerSwitch" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#D8CFBD"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Body" Background="#161B21" CornerRadius="6" BorderBrush="#343943" BorderThickness="1" Padding="9,7">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
      <ContentPresenter VerticalAlignment="Center"/>
      <Border x:Name="Track" Grid.Column="1" Width="28" Height="16" CornerRadius="8" Background="#353A42" HorizontalAlignment="Right">
       <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="#969B9F" HorizontalAlignment="Left" Margin="3,0,0,0"/>
      </Border>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#84683D"/><Setter TargetName="Track" Property="Background" Value="#775D2D"/><Setter TargetName="Thumb" Property="Fill" Value="#FFE1A3"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#D1AD68"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#171C23"/><Setter Property="Foreground" Value="#E9DFC9"/><Setter Property="Padding" Value="7,5"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#493A24"/></Trigger></Style.Triggers></Style>
  <Style x:Key="RegionStyle" TargetType="ComboBox">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" Background="#171C23" BorderBrush="#514531" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"/></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <TextBlock Margin="8,5,25,5" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"/>
     <Path Data="M0,0 L4,4 L8,0" Stroke="#CEAD6B" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
      <Border Background="#171C23" BorderBrush="#80653D" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
       <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="#95733E" BorderThickness="1" CornerRadius="11" Background="#F20E1218" Padding="11,10,11,9">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="Heading" MouseLeftButtonDown="DragHeader" Margin="0,0,0,9" Background="Transparent">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="Brand" Width="21" Height="21" Margin="0,0,6,0"/><TextBlock Text="TRACKER PETÓW" FontSize="12" FontWeight="SemiBold" Foreground="#ECCE8A" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="ChooseButton" Content="+" Click="ChooseClick" Width="24" Height="23" Padding="0" FontSize="16" ToolTip="Wybierz własną listę petów"/>
     <Button x:Name="LockButton" Click="LockClick" Width="24" Height="23" Margin="4,0,0,0" Padding="4" ToolTip="Zablokuj pozycję i rozmiar okna"><Path Data="M4,9 L16,9 L16,19 L4,19 Z M6,9 L6,5 A4,4 0 0 1 14,5 L14,9" Stroke="#C7B17D" StrokeThickness="1.5" Stretch="Uniform"/></Button>
     <Button Content="—" Click="HideClick" Width="24" Height="23" Margin="4,0,0,0" Padding="0" ToolTip="Ukryj tracker · Ctrl+Shift+T"/>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,0,0,9">
    <ComboBox x:Name="RegionPicker" Style="{StaticResource RegionStyle}" DisplayMemberPath="Name" SelectionChanged="RegionChanged" Foreground="#E9D6AE" FontSize="11"/>
    <TextBlock x:Name="Summary" FontSize="10.5" Foreground="#B9AE98" Margin="1,6,0,0" TextWrapping="Wrap"/>
   </StackPanel>
   <CheckBox x:Name="Automatic" Grid.Row="2" Content="Wszystkie poniżej MAX" Style="{StaticResource TrackerSwitch}" FontSize="11" Checked="AutomaticChanged" Unchecked="AutomaticChanged" Margin="0,0,0,9" ToolTip="Włącz: wszystkie nieukończone pety. Wyłącz: Twoja lista wybrana przyciskiem +."/>
   <Grid Grid.Row="3">
    <ListBox x:Name="PetList" BorderThickness="0" Background="Transparent" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Button Click="PetClick" Tag="{Binding Entry}" Margin="0,0,0,5" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch" ToolTip="{Binding Tip}" Background="Transparent">
       <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Row" Background="#1A2027" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#2B2C27"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
       <Grid Margin="6,6,7,5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2"/></Grid.RowDefinitions>
        <Border Width="35" Height="35" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{Binding GenusBrush}" CornerRadius="5" ClipToBounds="True" Background="#222831"><Image Source="{Binding Portrait}" Stretch="UniformToFill"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,7,0">
         <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F4ECDC" TextTrimming="CharacterEllipsis"/>
         <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="{Binding Levels}" Foreground="{Binding GenusBrush}" FontSize="8" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding Counter}" Foreground="#C9BEA9" FontSize="10"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding Distance}" Foreground="#E0C286" FontSize="10.5" TextAlignment="Right"/><TextBlock Text="{Binding Remaining}" Foreground="#948B7C" FontSize="8.5" TextAlignment="Right" Margin="0,3,0,0"/></StackPanel>
        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="2" Margin="0,4,0,0" Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Background="#363328" Foreground="#DBB865" BorderThickness="0"/>
       </Grid>
      </Button>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="Empty" Foreground="#B0A58F" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12" FontSize="11"/>
   </Grid>
   <TextBlock x:Name="Footnote" Grid.Row="4" Foreground="#8E8778" FontSize="9" Margin="1,8,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Border>
</Window>
